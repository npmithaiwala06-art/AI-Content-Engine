{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SocialFlow OS",
  "version": "0.3.4",
  "identifier": "com.socialflow.localos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SocialFlow OS",
        "width": 1440,
        "height": 920,
        "minWidth": 1120,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.icns"],
    "category": "Business",
    "shortDescription": "Local social media automation",
    "longDescription": "Manage multiple clients and social platforms locally, with human approval before scheduling and publishing.",
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ4NDg1ODA5RkQ4OTNBNTQKUldSVU9vbjlDVmhJMk5KS2dyMUQyOEphTzIzN3E5d3BhUEdFWTlEK2Rwa3ROYkdxeTBWcDQ0K1kK",
      "endpoints": [
        "https://github.com/npmithaiwala06-art/AI-Content-Engine/releases/latest/download/latest.json"
      ]
    }
  }
}
